rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read/write only their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Tasks subcollection
      match /tasks/{taskId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Categories subcollection
      match /categories/{catId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Weekly notes subcollection
      match /weeklyNotes/{weekKey} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Partner can read another user's public stats (read-only)
    match /users/{userId} {
      allow read: if request.auth != null;
    }

    // Partner tasks — read-only for authenticated users (for partner view)
    match /users/{userId}/tasks/{taskId} {
      allow read: if request.auth != null;
    }

    // Invite codes — any authenticated user can read & create
    match /inviteCodes/{code} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }
  }
}
